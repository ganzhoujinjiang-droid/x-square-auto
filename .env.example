# ============================================================
# X → Binance Square 自动同步系统 · 环境变量模板
#
# 使用方式：复制为 .env 并填入真实值。.env 已在 .gitignore 中，
# 任何情况下都不得把真实密钥提交到仓库（§19.4）。
#
# ⚠️ APP_ENCRYPTION_KEY 丢失 = 所有已保存的 Token 与 API Key 永久无法解密，
#    请务必离线备份（§19.4）。
# ============================================================

# --- 应用基础 ---
NODE_ENV=development
# 服务端口：仅 Docker 内网可达，不映射宿主机（§16.2 / §19.3）
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://127.0.0.1:4000

# --- 加密 ---
# 32 字节 base64（AES-256-GCM 密钥）。缺失或格式错误时进程拒绝启动（§7.4）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# --- 数据库 / 缓存 ---
# 只在 Docker 内部网络使用，禁止把 5432 / 6379 映射到宿主机（§16.2）
# docker-compose.yml 用 POSTGRES_PASSWORD 初始化 postgres 容器，并拼接 DATABASE_URL
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/x_square_auto?schema=public
REDIS_URL=redis://localhost:6379

# --- 后台会话 ---
# 32 字节以上随机字符串，用于 Session 签名与 CSRF Token（§19.2）
SESSION_SECRET=

# --- X API（OAuth 2.0 Authorization Code + PKCE，§7） ---
# 申请步骤见 docs/X-App-申请指南.md
# scope 只申请 tweet.read / users.read / offline.access，不申请任何写入权限（§7.2）
X_CLIENT_ID=
X_CLIENT_SECRET=
# 授权完成后的回调地址，必须与 X Developer Portal 中登记的完全一致
X_REDIRECT_URI=http://127.0.0.1:4000/api/x/oauth/callback

# --- Binance Square OpenAPI（§11） ---
# 获取路径：https://www.binance.com/square/creator-center/home
#   → AI Skills / API Management → 生成 Publishing API Key
# 该密钥与资产、交易接口完全隔离，泄露不会危及资金（§11.2）
BINANCE_SQUARE_API_KEY=

# --- 初始管理员（prisma seed 使用，§19.1） ---
# 首次登录后强制修改密码。禁止使用 admin123 之类的弱口令（§25.3）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- AI 模块（V1 默认关闭，§15） ---
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- 日志 ---
# fatal / error / warn / info / debug / trace，生产环境用 info（§20.2）
LOG_LEVEL=info

# --- 媒体临时目录（§12） ---
# 容器内路径；任务结束后立即清理，进程启动时清空残留
MEDIA_TMP_DIR=/tmp/x-square-media
