{
  "name": "x-square-auto",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted pipeline that mirrors your own X (Twitter) posts to Binance Square using only official APIs.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @x-square/api dev",
    "dev:web": "pnpm --filter @x-square/web dev",
    "dev:worker": "pnpm --filter @x-square/worker dev",
    "db:generate": "pnpm --filter @x-square/database generate",
    "db:migrate": "pnpm --filter @x-square/database migrate",
    "db:deploy": "pnpm --filter @x-square/database deploy",
    "db:seed": "pnpm --filter @x-square/database seed",
    "db:studio": "pnpm --filter @x-square/database studio",
    "clean": "pnpm -r exec rimraf dist .next .turbo node_modules/.cache"
  },
  "devDependencies": {
    "@prisma/client": "6.2.1",
    "@types/node": "^22.10.5",
    "@x-square/crypto": "workspace:*",
    "@x-square/database": "workspace:*",
    "@x-square/schemas": "workspace:*",
    "@x-square/shared": "workspace:*",
    "prisma": "6.2.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
