{
  "name": "@x-square/workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo \"(lint not configured)\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@x-square/ai": "workspace:*",
    "@x-square/binance-client": "workspace:*",
    "@x-square/crypto": "workspace:*",
    "@x-square/database": "workspace:*",
    "@x-square/queue": "workspace:*",
    "@x-square/schemas": "workspace:*",
    "@x-square/shared": "workspace:*",
    "@x-square/x-client": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.11.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
